# Wallets to copy are configured in copy-trader.js (TARGET_WALLETS array:
# [{ address: "0x...", category: "esports" }, ...])
# TARGET_USERS env (comma-separated) still works as an override for testing.

# Your credentials (needed only when DRY_RUN=0)
PRIVATE_KEY=
# Your Polymarket proxy wallet address (the one holding your USDC)
FUNDER_ADDRESS=
# 1 = email/Magic login proxy, 2 = browser-wallet (Gnosis Safe) proxy
SIGNATURE_TYPE=1

# USDC spent per copied test bet (Polymarket minimum is $1).
# With MIRROR_TRADER_BET=1 this becomes the CAP per bet instead.
MAX_BET_USDC=1

# 1 = bet the same USDC the trader bet (capped at MAX_BET_USDC, min $1).
# 0 = always bet exactly MAX_BET_USDC.
MIRROR_TRADER_BET=0

# Mirror mode only: what to do when the trader bets under Polymarket's $1
# order minimum (exact matching is impossible below it).
# 1 = skip the trade entirely, 0 = round the bet up to $1.
SKIP_BELOW_MIN=0

# Stop after this many placed trades, 0 = unlimited.
# Set to 1 for the first live run to verify one order end-to-end.
MAX_TRADES=1

# Poll interval (5s so copies land before fast markets move)
POLL_INTERVAL_MS=5000

# Dashboard port (npm run dashboard)
DASHBOARD_PORT=3210

# 1 = log orders instead of placing them (use this on the blocked machine)
DRY_RUN=1

# Optional overrides
# DATA_API_HOST=https://data-api.polymarket.com
# CLOB_API_HOST=https://clob.polymarket.com

# --- Risk gate ---
# Active-in-trading cap: a new bet is only placed while
# (active bets + new bet) <= MAX_ACTIVE_PCT% of your money (balance + active).
# 0 = gate disabled.
MAX_ACTIVE_PCT=50

# Paper balance the gate uses in DRY_RUN (fake money; debited on simulated
# bets, credited on simulated wins; resets on `yarn reset`).
DRY_RUN_BALANCE_USDC=100

# How often unresolved markets are re-checked to free up gate capacity (ms).
# RESOLUTION_RECHECK_MS=60000

# Self-shutdown: after this many consecutive polls where every wallet fails
# with a network error (e.g. "fetch failed"), the engine runs `yarn down`
# instead of spinning forever. 0 = never shut down.
FETCH_FAIL_LIMIT=3
