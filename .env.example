# Wallets to copy are configured in copy-trader.js (TARGET_WALLETS array:
# [{ address: "0x...", category: "esports" }, ...])
# TARGET_USERS env (comma-separated) still works as an override for testing.

# Your credentials (needed only when DRY_RUN=0)
PRIVATE_KEY=
# Your Polymarket proxy wallet address (the one holding your USDC)
FUNDER_ADDRESS=
# 1 = email/Magic login proxy, 2 = browser-wallet (Gnosis Safe) proxy
SIGNATURE_TYPE=1

# USDC spent per copied test bet (Polymarket minimum is $1).
# With MIRROR_TRADER_BET=1 this becomes the CAP per bet instead.
MAX_BET_USDC=1

# 1 = bet the same USDC the trader bet (capped at MAX_BET_USDC, min $1).
# 0 = always bet exactly MAX_BET_USDC.
MIRROR_TRADER_BET=0

# Mirror mode only: what to mirror.
# usdc   = copy the trader's $ spend
# shares = copy the trader's share count (always placed as a limit order,
#          so the 5-share minimum applies; worst-case cost capped at MAX_BET_USDC)
MIRROR_UNIT=usdc

# Order style for buys.
# market = FAK market order, denominated in $ ($1 order minimum)
# limit  = marketable FAK limit order, denominated in shares, priced at the
#          trader's price + the fixed 0.05 overpay cap (5-share order minimum). Hard price
#          protection: can never fill above the cap, but may fill nothing
#          when the market gaps past it. MIRROR_UNIT=shares forces limit.
ORDER_TYPE=market

# Mirror mode only: what to do when the trader's bet is under the order
# minimum (exact matching is impossible below it — $1 for market orders,
# 5 shares for limit orders).
# 1 = skip the trade entirely, 0 = round up to the minimum.
SKIP_BELOW_MIN=0

# Stop after this many placed trades, 0 = unlimited.
# Set to 1 for the first live run to verify one order end-to-end.
MAX_TRADES=1

# Poll interval (5s so copies land before fast markets move)
POLL_INTERVAL_MS=5000

# Dashboard port (npm run dashboard)
DASHBOARD_PORT=3210

# 1 = log orders instead of placing them (use this on the blocked machine)
DRY_RUN=1

# Optional overrides
# DATA_API_HOST=https://data-api.polymarket.com
# CLOB_API_HOST=https://clob.polymarket.com

# --- Risk gate ---
# Active-in-trading cap: a new bet is only placed while
# (active bets + new bet) <= MAX_ACTIVE_PCT% of your money (balance + active).
# 0 = gate disabled.
MAX_ACTIVE_PCT=50

# Price-deviation guard: only copy while the book still agrees with the
# trader's price. A cheaper-than-theirs fill is not a discount — in a fast
# market the ask only falls because the bet is already losing.
# Tolerances are fixed in copy-trader.js: skip if our price is >0.03 below the
# trader's (market already moving against the bet) or >0.05 above it (paying
# up for a worse edge). With ORDER_TYPE=limit, trader's price + 0.05 is also
# the hard limit price per share.
DRIFT_GUARD=1

# Paper balance the gate uses in DRY_RUN (fake money; debited on simulated
# bets, credited on simulated wins; resets on `yarn reset`).
DRY_RUN_BALANCE_USDC=100

# How often unresolved markets are re-checked to free up gate capacity (ms).
# RESOLUTION_RECHECK_MS=60000

# Self-shutdown: after this many consecutive polls where every wallet fails
# with a network error (e.g. "fetch failed"), the engine runs `yarn down`
# instead of spinning forever. 0 = never shut down.
FETCH_FAIL_LIMIT=3

# --- Bot signals ---
# 1 = the copy-trader also takes trade signals from the updown-5m strategy
# bot: updown-5m.js writes its intended trades to updown-signals.ndjson and
# the copier executes them at the signal's exact price/size, under its own
# journal, risk gate and dashboard. Signals under 5 shares are skipped, so
# MAX_BET_USDC should be ~$3+ for 50c markets.
# 0 = they run independently (the bot places its own orders directly).
BOT_SIGNALS=1

# Pair-fill watchdog (copy-trader, signal mode): a posted updown pair that is
# not FULLY filled after this many seconds is cancelled, and any one-legged
# exposure (one side filled, the other not) is immediately sold back at the
# best bid — a small, known spread cost instead of an open directional bet.
# Matched Up+Down fills are kept (they pay $1/share either way); only the
# imbalance is sold. Unwinds show as CANCELLED / SOLD BACK on the dashboard.
# 0 = disabled (orders rest until UPDOWN_CANCEL_BEFORE_CLOSE_SEC).
UPDOWN_UNWIND_SEC=50

# --- Delta bot (delta-signals.js): Binance -> Polymarket lead-lag takes ---
# Watches Binance spot (bookTicker ws) and the Polymarket up/down books
# (market ws) at once. Each 5m window it captures the strike (Binance price
# at open) and computes a fair Up-probability from live spot, time left and
# realized vol. When a Polymarket ask lags the Binance move by at least
# DELTA_EDGE probability points, it emits a "take" buy signal that the
# copy-trader executes as a FAK (same pipeline/journal as the updown bot).
# 1 = log edges only (default), 0 = emit live signals to the copier
DELTA_DRY_RUN=1
# markets to watch; the prefix maps to the Binance symbol (btc -> BTCUSDT)
DELTA_SLUG_PREFIX=btc-updown-5m
# shares per take (CLOB 5-share minimum; MAX_BET_USDC must cover a leg)
DELTA_SHARES=5
# minimum edge (fair - ask) to fire, in probability points. Keep wide: it
# must absorb strike/feed drift vs the market's official resolution source.
DELTA_EDGE=0.06
# per market+side seconds between signals, and max signals per 5m window
DELTA_COOLDOWN_SEC=15
DELTA_MAX_SIGNALS=4
# no signals in the first/last seconds of a window, and only for asks
# inside the price band (outside it the market is basically decided)
DELTA_ENTRY_START_SEC=10
DELTA_MIN_TAU_SEC=15
DELTA_MIN_PRICE=0.10
DELTA_MAX_PRICE=0.90
# BINANCE_WS_URL=wss://data-stream.binance.vision
# BINANCE_REST_HOST=https://data-api.binance.vision
# CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- MM bot (mm-bot.js): clone of wallet 0xeebde7a0…eba30 ---
# Standalone market maker (npm run mm) — NOT started by `npm run up`.
# Quotes passive bids on BOTH sides of crypto up/down markets, each priced
# below ITS OWN fair value (Binance spot vs window strike + time + vol) rather
# than requiring the legs to sum under $1 — that is what the analysed wallet
# actually does (median pair cost 1.018, only 39% riskless arb). It re-quotes
# as fair moves, cuts losers aggressively into the bid when fair turns, and
# holds the rest to resolution. See wallet-analysis-0xeebde7a0.md.
# 1 = simulate (no orders placed); 0 = live
MM_DRY_RUN=1
# markets to make, comma-separated; duration parsed from the slug
MM_SERIES=btc-updown-5m
MM_SHARES=5              # shares per clip (CLOB minimum 5; wallet's median fill was $5)
MM_MARGIN=0.04           # quote this far BELOW fair — our edge per share
MM_REQUOTE=0.02          # re-quote when fair moves our target this far from the resting bid
MM_MAX_CLIPS_PER_SIDE=2  # inventory cap per token
MM_MAX_ACTIVE_USDC=50    # hard cap on cost basis outstanding at once
MM_MIN_PRICE=0.08        # never quote outside this band (market too decided)
MM_MAX_PRICE=0.92
# Sit out when the book disagrees with our fair by more than this. A large gap
# usually means OUR MODEL is wrong (the crowd sees momentum the formula can't),
# and quoting into it is how a maker ends up buying the losing side all day.
MM_MAX_DISAGREE=0.15
MM_QUOTE_START_SEC=15    # start quoting this far into the window
MM_QUOTE_END_FRAC=0.75   # stop quoting after this fraction of the window
MM_CANCEL_BEFORE_CLOSE_SEC=20
# Exits — the wallet cut 44% of all shares bought, median 54s after buying
MM_EXIT_FAIR_DROP=0.12   # cut if fair falls this far below entry fair
MM_EXIT_FAIR_FLOOR=0.35  # cut if fair for the held side drops under this
MM_EXIT_MAX_HOLD_SEC=120 # backstop (their p75 hold was 108s)
MM_EXIT_MIN_TAU_SEC=12   # too close to close to exit cleanly — let it resolve
# A cut sells into the bid, so it pays the spread every time. Entries already
# refuse to trade when the book disagrees with the model by MM_MAX_DISAGREE;
# with this on, model-driven cuts need the same corroboration. (The book's own
# verdict still stands alone: mid under the floor always cuts.) Measured over
# 167 closed positions with this OFF: 148 cuts -$79.75 vs +$24.60 from the 19
# positions simply held to resolution. Set 0 to restore model-only exits.
MM_EXIT_REQUIRE_BOOK=1
MM_EXIT_QUOTE_BUFFER=0.05  # don't quote within this of the cut floor — a fill
                           # and its cut on the same tick is pure spread paid
# Floor on tau inside the fair model. P(up) divides by sqrt(tau), so without it
# fair snaps to 0/1 as the window closes; mean absolute error tripled (0.107 ->
# 0.331) in the final sixth of the window, and the book contradicted half of
# those extreme readings. 0 disables.
MM_FAIR_MIN_TAU_SEC=30
MM_DEBUG=0               # 1 = log why a leg is not being quoted
# Runs on the WINDOWS trading machine only. At startup it probes Binance
# (REST+ws), gamma, the CLOB REST API and the CLOB book websocket, and refuses
# to start if any is blocked — on a restricted network its resting orders would
# lag the market and get picked off. Set to 1 only to exercise the logic
# locally (no trading value).
MM_SKIP_PREFLIGHT=0
MM_LOOP_MS=250           # quote loop with the book websocket up (push mode)
MM_REST_LOOP_MS=1000     # slower loop when degraded to REST book polling
MM_BOOK_STALE_MS=4000    # pull quotes if the book goes older than this
# Fills arrive by push on the CLOB user websocket (knowing you are filled is
# what starts the cut clock). REST getOrder stays as a reconciliation sweep on
# this slower timer; without the socket it falls back to polling every tick.
MM_FILL_RECONCILE_MS=2000
MM_USER_WS_SILENCE_MS=30000

# --- Real-time signal ---
# 1 = subscribe to Polymarket's live-trade websocket and copy the instant the
# target trades (~1s vs 13-25s on the REST activity API). The poller keeps
# running as fallback + reconciliation; duplicates are impossible (txHash dedupe).
WS_ENABLED=1
# WS_URL=wss://ws-live-data.polymarket.com
# 1 = log every raw websocket message (very verbose — for inspecting the
# stream's shape; even at 0, the first 3 messages after each connect are logged)
# WS_DEBUG=0
